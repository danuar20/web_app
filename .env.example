# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here

# Webapp Database For user management
WEBAPP_DB_HOST=HOST_IP_ADDRESS
WEBAPP_DB_PORT=HOST_PORT
WEBAPP_DB_NAME=DB_NAME
WEBAPP_DB_USER=DB_USER
WEBAPP_DB_PASSWORD=DB_PASSWORD

# PostgreSQL Database For hourly data storage
POSTGRES_DB_HOST=HOST_IP_ADDRESS
POSTGRES_DB_PORT=HOST_PORT
POSTGRES_DB_NAME=DB_NAME
POSTGRES_DB_USER=DB_USER
POSTGRES_DB_PASSWORD=DB_PASSWORD

# Pumaz Database For daily data storage
PUMAZ_DB_HOST=HOST_IP_ADDRESS
PUMAZ_DB_PORT=HOST_PORT
PUMAZ_DB_NAME=DB_NAME
PUMAZ_DB_USER=DB_USER
